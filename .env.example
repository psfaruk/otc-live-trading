# Copy to .env for local dev. On Railway, set these as Variables in the
# dashboard instead of committing a .env file (never commit real credentials).

# ── Auth (token-only — no email/password, no API keys, no admin keys) ────────
# The ONLY auth path is a Quotex SSID token. Email/password login is no longer
# supported (Cloudflare's JS challenge blocks the HTTP sign-in page on every
# non-browser client, so retrying it just hammered Quotex with bad credentials).
# The frontend Settings tab exposes ONLY a token input — paste the SSID there
# and the feed connects with it. The token is stored in-memory only and
# cleared on process restart. The feed does EXACTLY ONE connect attempt per
# token; if it fails, the operator must paste the SSID again to retry once.
# QX_TOKEN env var is an alternative for headless setups (same SSID value).

QX_TOKEN=
# Optional — override the User-Agent string sent to Quotex. Leave blank to use
# the default Chrome-on-Windows UA (Cloudflare seems happiest with this).
QX_UA=
# Optional — cross-platform temp cache dir for pyquotex; leave blank to use
# the OS default temp dir.
QX_ROOT=

# ── Multi-viewer safety net (see feed.py _AssetStream manager) ───────────────
# Optional — defaults shown. QX_MAX_STREAMS covers the always-on forex pairs
# (see QX_PAYOUT_FLOOR below) plus on-demand extras.
QX_MAX_STREAMS=45
QX_STAGGER_GAP_SEC=1.5

# Minimum live 1-minute payout % a forex pair needs to be streamable at all.
# Pairs at or above this run continuously from server boot (always-on);
# pairs below it are blocked from opening entirely. Optional — defaults to
# 81 (Quotex's own "worth trading" cutoff).
QX_PAYOUT_FLOOR=81

# Optional — point the SQLite DB at a Railway persistent Volume so
# candle_micro.db survives redeploys (e.g. /data/candle_micro.db). Leave
# blank for local dev (defaults to a file next to db.py).
QX_DB_PATH=

# Optional — override the Quotex host (defaults to qxbroker.com).
QX_HOST=

# Railway injects this automatically — do not set manually
# PORT=
